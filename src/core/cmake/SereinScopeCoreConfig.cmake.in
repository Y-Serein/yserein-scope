@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 @Qt6_VERSION@ EXACT COMPONENTS Core Gui Widgets Network)

# Native Qt/C++ plugins share a process with the host.  Reject toolchains that
# cannot safely consume the SDK's binary import library.
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "@CMAKE_CXX_COMPILER_ID@"
   OR NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL "@CMAKE_CXX_COMPILER_VERSION@")
    message(FATAL_ERROR
        "Serein Scope SDK requires @CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@; "
        "current compiler is ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
endif()
if(NOT CMAKE_SIZEOF_VOID_P EQUAL @CMAKE_SIZEOF_VOID_P@)
    message(FATAL_ERROR "Serein Scope SDK CPU architecture does not match this build")
endif()
if(NOT CMAKE_SYSTEM_PROCESSOR STREQUAL "@CMAKE_SYSTEM_PROCESSOR@")
    message(FATAL_ERROR "Serein Scope SDK CPU processor does not match this build")
endif()
if(NOT CMAKE_SYSTEM_NAME STREQUAL "@CMAKE_SYSTEM_NAME@")
    message(FATAL_ERROR "Serein Scope SDK target platform does not match this build")
endif()

set(SEREIN_SCOPE_CORE_VERSION "@SEREIN_SCOPE_CORE_VERSION@")
set(SEREIN_SCOPE_PLUGIN_ABI 2)
include("${CMAKE_CURRENT_LIST_DIR}/SereinScopeCoreTargets.cmake")
check_required_components(SereinScopeCore)
