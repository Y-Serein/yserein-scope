; ============================================================================
; Serein Scope NSIS installer - template
; Generated by tools/package_windows_installer.ps1
;
; Placeholders (@@...@@) are substituted by the packaging script:
;   @@VERSION@@      product version (e.g. 1.0.1)
;   @@SRC_DIR@@      flat candidate directory to package (out\yserein-scope)
;   @@OUT_FILE@@     resulting installer file name
; ============================================================================
Unicode true
ManifestDPIAware true
SetCompressor /SOLID lzma

!define PRODUCT_NAME "Serein Scope"
!define PRODUCT_VERSION "@@VERSION@@"
!define PRODUCT_PUBLISHER "Serein"
!define MANU_KEY "Software\Serein\SereinScope"
!define UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\Serein Scope"
!define SRC_DIR "@@SRC_DIR@@"
!define OUT_FILE "@@OUT_FILE@@"

Name "${PRODUCT_NAME}"
OutFile "${OUT_FILE}"
; Default install location (per-user, no admin required).
InstallDir "$LOCALAPPDATA\Serein\Serein Scope"
; Remember the last chosen location, so a reinstall pre-fills the current path.
InstallDirRegKey HKCU "${MANU_KEY}" "InstallLocation"
RequestExecutionLevel user

!include "MUI2.nsh"

; ---------------------------------------------------------------------------
; Installer pages
; ---------------------------------------------------------------------------
!define MUI_ABORTWARNING
!insertmacro MUI_PAGE_WELCOME

; Always show the directory page. InstallDirRegKey pre-fills the default
; location from the registry, so a reinstall shows the current install path
; as the default rather than skipping the page entirely.
!insertmacro MUI_PAGE_DIRECTORY

!insertmacro MUI_PAGE_INSTFILES

!define MUI_FINISHPAGE_RUN "$INSTDIR\SereinScope.exe"
!define MUI_FINISHPAGE_RUN_TEXT "运行 Serein Scope"
!insertmacro MUI_PAGE_FINISH

; ---------------------------------------------------------------------------
; Uninstaller pages
; ---------------------------------------------------------------------------
!insertmacro MUI_UNPAGE_WELCOME
!insertmacro MUI_UNPAGE_CONFIRM
; Custom page: choose which installed components to remove along with the app.
UninstPage custom un.ComponentSelectPage un.ComponentSelectPageLeave
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_UNPAGE_FINISH

!insertmacro MUI_LANGUAGE "SimpChinese"

; ---------------------------------------------------------------------------
; Variables
; ---------------------------------------------------------------------------
Var ComponentCount

; ---------------------------------------------------------------------------
; Main install section
; ---------------------------------------------------------------------------
Section "Serein Scope" SEC_MAIN
    SetOutPath "$INSTDIR"

    ; Copy the flat candidate delivery (host, core, Qt runtime, Components).
    File /r "${SRC_DIR}\*.*"

    ; Write the uninstaller.
    WriteUninstaller "$INSTDIR\uninstall.exe"

    ; Remember the install location for future (re)installs.
    WriteRegStr HKCU "${MANU_KEY}" "InstallLocation" "$INSTDIR"

    ; Register the app in "Add/Remove Programs".
    WriteRegStr HKCU "${UNINST_KEY}" "DisplayName" "${PRODUCT_NAME}"
    WriteRegStr HKCU "${UNINST_KEY}" "DisplayVersion" "${PRODUCT_VERSION}"
    WriteRegStr HKCU "${UNINST_KEY}" "Publisher" "${PRODUCT_PUBLISHER}"
    WriteRegStr HKCU "${UNINST_KEY}" "InstallLocation" "$INSTDIR"
    WriteRegStr HKCU "${UNINST_KEY}" "UninstallString" '"$INSTDIR\uninstall.exe"'
    WriteRegStr HKCU "${UNINST_KEY}" "DisplayIcon" "$INSTDIR\SereinScope.exe"
    WriteRegDWORD HKCU "${UNINST_KEY}" "NoModify" "1"
    WriteRegDWORD HKCU "${UNINST_KEY}" "NoRepair" "1"

    ; Start menu and desktop shortcuts.
    CreateDirectory "$SMPROGRAMS\Serein Scope"
    CreateShortcut "$SMPROGRAMS\Serein Scope\Serein Scope.lnk" "$INSTDIR\SereinScope.exe"
    CreateShortcut "$DESKTOP\Serein Scope.lnk" "$INSTDIR\SereinScope.exe"
SectionEnd

; ---------------------------------------------------------------------------
; Custom uninstaller page: pick (a subset of) installed components to remove.
; ---------------------------------------------------------------------------
Function un.ComponentSelectPage
    ; Count installed components; skip the page if there are none.
    StrCpy $ComponentCount 0
    IfFileExists "$INSTDIR\Components\*.*" 0 noComponents
    StrCpy $R0 "$INSTDIR\Components\*"
    FindFirst $R1 $R2 $R0
    StrCmp $R2 "" countDone
    countLoop:
      StrCmp $R2 "." countNext
      StrCmp $R2 ".." countNext
      IfFileExists "$INSTDIR\Components\$R2\*.*" 0 countNext
      IntOp $ComponentCount $ComponentCount + 1
    countNext:
      FindNext $R1 $R2
      StrCmp $R2 "" countDone
      Goto countLoop
    countDone:
      FindClose $R1
    StrCmp $ComponentCount "0" noComponents

    ; Create the dialog.
    nsDialogs::Create 1018
    Pop $R6
    StrCmp $R6 "error" 0 +2
      Abort

    ; Headline
    nsDialogs::CreateControl "STATIC" "请选择要卸载的组件：" "0x50000000" "" "0" "0u" "100%" "16u" ""
    Pop $R0

    ; Radio 1: remove the whole delivery (software + all components)
    nsDialogs::CreateControl "BUTTON" "全部卸载（软件 + 所有组件）" "0x50030009" "" "0" "16u" "100%" "12u" "101"
    Pop $R7
    System::Call 'user32::SendMessageW(p $R7,i 0x00F1,p 1,p 0)'

    ; Radio 2: software only, all components stay
    nsDialogs::CreateControl "BUTTON" "只卸载软件（保留所有组件）" "0x50010009" "" "0" "28u" "100%" "12u" "102"
    Pop $R8

    ; Radio 3: pick components below
    nsDialogs::CreateControl "BUTTON" "按下方勾选卸载组件" "0x50010009" "" "0" "40u" "100%" "12u" "103"
    Pop $R9

    ; One checkbox per component, all checked by default.
    StrCpy $R5 52
    StrCpy $R2 0
    StrCpy $R0 "$INSTDIR\Components\*"
    FindFirst $R1 $R3 $R0
    StrCmp $R3 "" boxDone
    boxLoop:
      StrCmp $R3 "." boxNext
      StrCmp $R3 ".." boxNext
      IfFileExists "$INSTDIR\Components\$R3\*.*" 0 boxNext
      IntOp $R4 200 + $R2
      nsDialogs::CreateControl "BUTTON" "$R3" "0x50010003" "" "0" "$R5u" "100%" "12u" "$R4"
      Pop $R0
      System::Call 'user32::SendMessageW(p $R0,i 0x00F1,p 1,p 0)'
      IntOp $R5 $R5 + 12
      IntOp $R2 $R2 + 1
    boxNext:
      FindNext $R1 $R3
      StrCmp $R3 "" boxDone
      Goto boxLoop
    boxDone:
      FindClose $R1

    nsDialogs::Show
    Return

noComponents:
    Abort
FunctionEnd

Function un.ComponentSelectPageLeave
    ; Radio 1 selected -> delete the whole Components store.
    System::Call 'user32::SendMessageW(p $R7,i 0x00F0,i 0,i 0)i.r0'
    StrCmp $0 "1" 0 +2
      RMDir /r "$INSTDIR\Components"
      Return

    ; Radio 2 selected -> keep every component.
    System::Call 'user32::SendMessageW(p $R8,i 0x00F0,i 0,i 0)i.r0'
    StrCmp $0 "1" 0 +2
      Return

    ; Radio 3 selected -> remove the ticked components.  Re-run the same
    ; directory walk as in un.ComponentSelectPage so each component can be
    ; matched to its control id (200 + index).
    StrCpy $R2 0
    StrCpy $R0 "$INSTDIR\Components\*"
    FindFirst $R1 $R3 $R0
    StrCmp $R3 "" selectDone
    selectLoop:
      StrCmp $R3 "." selectNext
      StrCmp $R3 ".." selectNext
      IfFileExists "$INSTDIR\Components\$R3\*.*" 0 selectNext
      IntOp $R4 200 + $R2
      System::Call 'user32::GetDlgItem(p $R6,i $R4)p.r0'
      StrCmp $0 "0" selectNext
      System::Call 'user32::SendMessageW(p $0,i 0x00F0,i 0,i 0)i.r1'
      StrCmp $1 "1" selectNext
      RMDir /r "$INSTDIR\Components\$R3"
    selectNext:
      IntOp $R2 $R2 + 1
      FindNext $R1 $R3
      StrCmp $R3 "" selectDone
      Goto selectLoop
    selectDone:
      FindClose $R1
    Return
FunctionEnd

; ---------------------------------------------------------------------------
; Uninstall section
; ---------------------------------------------------------------------------
Section "Uninstall"
    ; 1. Remove the app itself, but keep the Components directory (it holds any
    ;    components that were not ticked and should survive a software-only
    ;    uninstall).  Iterate over the root of $INSTDIR and remove everything
    ;    except "Components".
    StrCpy $R0 "$INSTDIR\*"
    FindFirst $R1 $R2 $R0
    delLoop:
      StrCmp $R2 "" delDone
      StrCmp $R2 "." delNext
      StrCmp $R2 ".." delNext
      StrCmp $R2 "Components" delNext
      IfFileExists "$INSTDIR\$R2\*.*" 0 delFile
        RMDir /r "$INSTDIR\$R2"
        Goto delNext
      delFile:
        Delete "$INSTDIR\$R2"
      delNext:
      FindNext $R1 $R2
      Goto delLoop
    delDone:
    FindClose $R1

    ; 2. Clean shortcuts and registry (install location is removed so the next
    ;    install falls back to the default path).
    Delete "$DESKTOP\Serein Scope.lnk"
    RMDir /r "$SMPROGRAMS\Serein Scope"
    DeleteRegKey HKCU "${UNINST_KEY}"
    DeleteRegKey HKCU "${MANU_KEY}"

    ; 3. Remove empty leftovers (Components directory only if nothing remains).
    RMDir "$INSTDIR\Components"
    RMDir "$INSTDIR"
SectionEnd
